int main() {
    const char *t[256] = {0};
    t[33] = "\"The water walked, and the garden was there\?\" She wrote \"C:\\home\\letters\" in her book.\n";
    t[35] = "\n";
    t[36] = "\"The weather listened, and the house was there\?\"\n";
    t[37] = "\"The house listened, and the night was there\?\"\n";
    t[38] = "The weather wondered, and the night was there.\n";
    t[39] = "The weather wondered,\n";
    for (int k = 0; d[k]; k++)
